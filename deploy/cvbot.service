[Unit]
Description=CVBot Telegram polling worker (Docker)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/docker start --attach cvbot
ExecStop=/usr/bin/docker stop --time 30 cvbot
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
